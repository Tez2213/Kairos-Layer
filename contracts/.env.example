# Contracts — copy to .env
#
# Needed ONLY to deploy or verify. The contracts are already deployed (see
# deployments.json), so you do not need any of this to run the app or the keeper.

# Deployer key. Owns the contract: can set parameters, appoint an auditor and
# sweep dust. Use a burner, and never reuse it for the keeper.
SEPOLIA_PRIVATE_KEY=

# Free key from https://etherscan.io/myapikey — only for `hardhat verify`.
ETHERSCAN_API_KEY=

# Optional: a dedicated RPC. A public endpoint is used when unset.
# SEPOLIA_RPC_URL=
