# Kairos Layer frontend — ALL VARIABLES ARE OPTIONAL.
# The app works with no configuration at all: it falls back to public Sepolia
# endpoints, and contract addresses are compiled into lib/generated.ts.
#
# Copy to .env.local for local dev, or set these in the Vercel dashboard.

# ---------------------------------------------------------------------------
# Recommended for a public deployment: a dedicated Sepolia endpoint.
# Set it SERVER-SIDE (no NEXT_PUBLIC_ prefix) and the browser talks to
# /api/rpc instead, so your API key is never shipped to the client.
# ---------------------------------------------------------------------------
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ---------------------------------------------------------------------------
# Alternative: give the browser the endpoint directly (one less hop, lower
# latency). WARNING — anything NEXT_PUBLIC_ is embedded in the JavaScript
# bundle and readable by anyone. Only use a key restricted to your domain.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_DOMAIN_RESTRICTED_KEY

# No other configuration exists. In particular:
#   - iExec Nox gateway, KMS and subgraph URLs ship inside @iexec-nox/handle,
#     selected automatically from the chain id.
#   - Contract addresses come from contracts/deployments.json at build time.
#   - There are no secrets, no private keys and no backend database.
