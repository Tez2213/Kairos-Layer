{
  "name": "kairos-keeper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Permissionless settlement keeper for Kairos Layer",
  "scripts": {
    "start": "node keeper.mjs",
    "once": "node keeper.mjs --once",
    "dry": "node keeper.mjs --dry-run --once",
    "sync-abi": "node -e \"const fs=require('fs');fs.writeFileSync('abi.json',JSON.stringify(JSON.parse(fs.readFileSync('../contracts/artifacts/contracts/KairosPool.sol/KairosPool.json','utf8')).abi,null,2)+'\\n')\""
  },
  "dependencies": {
    "@iexec-nox/handle": "0.1.0-beta.13",
    "ethers": "^6.17.0",
    "viem": "^2.55.10"
  }
}
